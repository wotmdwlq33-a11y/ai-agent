# 이 파일을 .env 로 복사해서 쓰세요. .env 는 git에 올라가지 않습니다(.gitignore).
# 이미 설정된 환경변수가 .env 값보다 우선합니다.

# Claude API 키 (또는 `ant auth login` 사용)
# ANTHROPIC_API_KEY=

# 사용할 Claude 모델 ID (필수, Claude를 호출할 때만)
JEV_MODEL=

# 데이터 폴더 (대화 기록, 메모, 알림). 기본: ~/.jev
# JEV_HOME=~/.jev

# 대화 기록 저장 on/off, 최대 메시지 수, 최대 크기(바이트)
# JEV_MEMORY=on
# JEV_MAX_HISTORY_MESSAGES=40
# JEV_MAX_HISTORY_BYTES=200000

# 응답 최대 토큰, 스트리밍 출력 on/off
# JEV_MAX_TOKENS=16000
# JEV_STREAM=on

# Claude에게 보내는 메시지 앞에 현재 시각 붙이기
# JEV_SEND_TIME=on
